{
  "name": "novel-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "deploy": "npm run build:pages && node scripts/deploy-pages.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "client:build": "vite build",
    "client": "vite build && node client/server.mjs",
    "client:run": "node client/server.mjs",
    "icons": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/make-icons.ps1",
    "tauri": "node scripts/tauri.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
